{
    "name": "contenir/contenir-page-cache-mezzio",
    "description": "Mezzio (PSR-15) adapter for contenir/contenir-page-cache: a full-page output cache middleware controlled by the Contenir admin.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "mezzio",
        "psr-15",
        "page-cache",
        "middleware"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-page-cache": "^2.0.0-RC2",
        "contenir/contenir-site-token": "^0.1",
        "contenir/contenir-config": "^2.1",
        "laminas/laminas-diactoros": "^3.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "laminas/laminas-cache": "^3.14.1",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.4",
        "laminas/laminas-serializer": "^2.17",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "laminas/laminas-cache": "To back the page cache with a laminas-cache storage adapter (the setup the Contenir admin's purge button understands)."
    },
    "conflict": {
        "contenir/cache-mezzio": "*",
        "contenir/contenir-cache-mezzio": "*"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\PageCache\\Mezzio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\PageCache\\Mezzio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\PageCache\\Mezzio\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
